# Docker applique ces mots de passe aux roles au premier demarrage.
PG_ACCUEIL_USER=utilisateur_accueil
PG_ACCUEIL_PASSWORD=baba
PG_COMPTA_USER=utilisateur_compta
PG_COMPTA_PASSWORD=baba
