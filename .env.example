# Copier ce fichier vers .env puis renseigner les valeurs localement.
PORT=4000
JWT_SECRET=remplacer-par-une-cle-aleatoire-longue-et-privee
APP_ACCUEIL_PASSWORD=
APP_COMPTA_PASSWORD=

PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=salle_sport
PG_SSL=false

# Utilisateurs PostgreSQL associes aux roles metiers existants.
PG_ACCUEIL_USER=utilisateur_accueil
PG_ACCUEIL_PASSWORD=
PG_COMPTA_USER=utilisateur_compta
PG_COMPTA_PASSWORD=
